{
  // `pixel3d-renderer` resolves through its package.json "exports" to the built declarations in lib/types.
  // Imports keep their .ts extension so the simulation code in src/game/ runs unchanged under Node's type stripping (tests).
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "skipLibCheck": true, "isolatedModules": true, "noEmit": true, "types": ["vite/client"],
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "verbatimModuleSyntax": true
  },
  "include": ["src", "vite.config.ts"]
}
