{
  "name": "soil-n-silo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A cozy farming and production game: soil, chickens and processing chains, drawn as pixel art.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node node_modules/typescript/bin/tsc -p test",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "eslint .",
    "sim": "node tools/sim.ts"
  },
  "dependencies": {
    "pixel3d-renderer": "github:CelestialLemon/pixel3d-renderer#v0.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.180.0",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.3"
  },
  "allowScripts": {
    "github:CelestialLemon/pixel3d-renderer#9a14f83bd6613548aff1442f1c9de2c39f8ef1e0": true
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    }
  }
}
