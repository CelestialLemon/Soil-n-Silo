{
  "name": "soil-n-silo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A cozy solarpunk automation game, rendered as a lush, painterly 3D valley.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test",
    "test": "node --test 'test/**/*.test.ts'",
    "sim": "node tools/sim.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.180.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
