{
  "name": "soil-n-silo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A cozy farming and production game: soil, chickens and processing chains, painted by its own renderer, brush3d.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node node_modules/typescript/bin/tsc -p test && node node_modules/typescript/bin/tsc -p brush3d/tools && node brush3d/tools/demo-imports.ts",
    "test": "node --test 'test/**/*.test.ts' 'brush3d/test/**/*.test.ts'",
    "lint": "eslint .",
    "sim": "node tools/sim.ts",
    "hitches": "node tools/hitches.ts",
    "framerate": "node tools/framerate.ts",
    "render:shot": "node brush3d/tools/shot.ts",
    "render:video": "node brush3d/tools/video.ts",
    "render:motion": "node brush3d/tools/motion.ts",
    "render:pops": "node brush3d/tools/pops.ts",
    "render:profile": "node brush3d/tools/profile.ts",
    "render:flash": "node brush3d/tools/flash.ts",
    "render:test:clouds": "node brush3d/tools/clouds.ts",
    "render:test:wind": "node brush3d/tools/wind.ts",
    "render:test:water": "node brush3d/tools/water.ts",
    "render:test:view": "node brush3d/tools/view.ts",
    "render:test:parts": "node brush3d/tools/parts.ts",
    "render:build:wind": "node brush3d/tools/wind-build.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.180.0",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.12.0",
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    }
  }
}
